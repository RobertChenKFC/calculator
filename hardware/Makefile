.DELETE_ON_ERROR:

# All the testbench verilog files
TEST_FILES := $(shell find tests -name '*.v')
# The actual target that runs the specific verilog testbench
TESTS := $(TEST_FILES:.v=.test)
# Flags to pass to iverilog
V_FLAGS := -Wmacro-replacement -Wimplicit
# vvp files generated from iverilog for use in simulation
VVP := $(TEST_FILES:.v=.vvp)
# The dependency file generated by iverilog, which contains the list of files a
# verilog file includes.
DEPS_TMP := $(TEST_FILES:.v=.d.tmp)
# The dependencies converted to Makefile rules so make can respect them (eg.
# recompile a module if an included module is modified)
DEPS := $(TEST_FILES:.v=.d)

# The corresponding source module file that a particular testbench is testing
SRC_FILES := $(patsubst tests/%_tb.v,src/%.v,$(TEST_FILES))
# The delay file that contains the propagation delay of that module
DELAY_FILES := $(SRC_FILES:.v=_delay.v)

.PHONY: all
all: $(TESTS)
	@echo "Tests: ${TEST_FILES}"

.PHONY: $(TESTS)
$(TESTS): %.test: %.vvp
	vvp $<

$(DELAY_FILES): %_delay.v: %.v
	scripts/generate_critical_path_file.py $<

$(TEST_FILES): tests/%_tb.v: src/%_delay.v

$(VVP): %.vvp: %.v
	scripts/run_checked.sh iverilog -M $*.d.tmp -o $@ $< $(V_FLAGS)
	@# Reformat the file list into a make rule
	@echo "$@: $$(tr '\n' ' ' < $*.d.tmp)" > $*.d
	@rm $*.d.tmp

.PHONY: clean
clean:
	rm -f $(VVP) $(DEPS) $(DEPS_TMP) $(DELAY_FILES)

-include $(DEPS)